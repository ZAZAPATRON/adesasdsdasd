package me.ali.donut;

import org.bukkit.command.*;
import org.bukkit.entity.Player;
import org.bukkit.inventory.ItemStack;
import org.bukkit.inventory.meta.ItemMeta;
import java.util.*;

public class EconomyManager implements CommandExecutor {
    private Map<UUID, Integer> balances = new HashMap<>();
    private final String currency = "Shards";

    public EconomyManager(Main plugin) {}

    private int getBalance(Player p) {
        return balances.getOrDefault(p.getUniqueId(), 0);
    }

    private void addBalance(Player p, int amount) {
        balances.put(p.getUniqueId(), getBalance(p) + amount);
    }

    @Override
    public boolean onCommand(CommandSender sender, Command cmd, String label, String[] args) {
        if (!(sender instanceof Player)) return true;
        Player p = (Player) sender;

        if (cmd.getName().equalsIgnoreCase("sell")) {
            ItemStack item = p.getInventory().getItemInMainHand();
            if (item == null || !item.hasItemMeta()) {
                p.sendMessage("§cSatılacak item yok!");
                return true;
            }
            ItemMeta meta = item.getItemMeta();
            if (meta.hasLore()) {
                for (String line : meta.getLore()) {
                    if (line.contains("Satış Değeri:")) {
                        int value = Integer.parseInt(line.replaceAll("[^0-9]", ""));
                        addBalance(p, value);
                        p.getInventory().removeItem(item);
                        p.sendMessage("§aItem satıldı! +" + value + " " + currency);
                        return true;
                    }
                }
            }
            p.sendMessage("§cBu itemin satış değeri yok!");
        }

        if (cmd.getName().equalsIgnoreCase("ah")) {
            p.sendMessage("§eAuction House sistemi burada basit placeholder!");
        }

        return true;
    }
}
