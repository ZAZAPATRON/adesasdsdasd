package me.ali.donut;

import org.bukkit.command.*;
import org.bukkit.entity.Player;
import org.bukkit.Location;
import java.util.*;

public class HomeManager implements CommandExecutor {
    private Map<UUID, Location> homes = new HashMap<>();

    public HomeManager(Main plugin) {}

    @Override
    public boolean onCommand(CommandSender sender, Command cmd, String label, String[] args) {
        if (!(sender instanceof Player)) return true;
        Player p = (Player) sender;

        if (cmd.getName().equalsIgnoreCase("sethome")) {
            homes.put(p.getUniqueId(), p.getLocation());
            p.sendMessage("§aHome ayarlandı!");
        }
        if (cmd.getName().equalsIgnoreCase("home")) {
            if (homes.containsKey(p.getUniqueId())) {
                p.teleport(homes.get(p.getUniqueId()));
                p.sendMessage("§aHome'a ışınlandın!");
            } else {
                p.sendMessage("§cHome ayarlamadın!");
            }
        }
        if (cmd.getName().equalsIgnoreCase("delhome")) {
            homes.remove(p.getUniqueId());
            p.sendMessage("§cHome silindi!");
        }
        return true;
    }
}
